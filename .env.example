# OUTBOUND Voicebot (Botnoi provisioning "place a call" contract)
# OUTBOUND_URL is the API base, e.g. https://..............com/api
# The client appends the provisioning path and places each call at:
#   POST {OUTBOUND_URL}/v1/provisioning/tenants/{OUTBOUND_TENANT_ID}/calls
# with body {destination, agent_id, metadata}.
OUTBOUND_URL=
OUTBOUND_ACCESS_TOKEN=
# Your setup id — the `_id` from GET /me — used as {tenant_id} in the calls URL.
OUTBOUND_TENANT_ID=
# The pre-configured Botnoi agent to dial with (agent_id in the call body, e.g.
# agt_12345678). Also used by the conversation-logs endpoints
# (/logs/list_file/ etc.), which filter by agent_id. Find it in the Botnoi console.
OUTBOUND_AGENT_ID=

# AI transcript analysis (webhook classification + callback-date extraction).
# Groq free API (OpenAI-compatible). Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Microsoft Authentication
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_JWKS_URL=https://login.microsoftonline.com/common/discovery/v2.0/keys

# Google Authentication
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
